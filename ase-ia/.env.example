# ============================================================================
#  ASE-IA · Variables de entorno (plantilla). Copia a .env y completa.
#  NUNCA subas .env al repositorio. Las claves viven SOLO en el servidor API.
# ============================================================================

# --- Servidor API (Express) ---
API_PORT=4000
NODE_ENV=development

# Orígenes autorizados a consumir la API (web + sitios institucionales)
ALLOWED_ORIGINS=http://localhost:3000,https://josejoaquinprieto.cl

# --- Proveedor de IA (intercambiable) ---
# Valores admitidos:
#   local     respuestas extractivas desde las fuentes, SIN clave ni costo
#   gemini    Google Gemini (requiere GEMINI_API_KEY)
#   openai    OpenAI GPT (requiere OPENAI_API_KEY)
#   anthropic Claude (requiere ANTHROPIC_API_KEY)
#   mock      respuesta de relleno para pruebas
AI_PROVIDER=local
AI_MODEL=

# Claves (solo se usa la del proveedor activo)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Firebase (Auth + Firestore) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Google Workspace (Classroom/Calendar/Drive) ---
# mock = datos simulados; google = APIs reales (requiere plomería de tokens OAuth)
WORKSPACE_PROVIDER=mock

# --- Web (Next.js) — variables públicas (prefijo NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
